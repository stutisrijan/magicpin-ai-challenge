# Vera bot configuration. Copy to .env (never commit it) or set these in your host's dashboard.
# Comments sit on their own lines so the file also works with `docker run --env-file`.
# Every setting is optional: with no LLM key the bot runs on deterministic templates only.

# --- identity (GET /v1/metadata) ---
TEAM_NAME=Stuti Srijan
# comma-separated
TEAM_MEMBERS=Stuti Srijan
CONTACT_EMAIL=
BOT_VERSION=1.0.0
SUBMITTED_AT=2026-09-26T00:00:00Z

# --- LLM providers (tried in this order; providers without a key are skipped) ---
LLM_PROVIDERS=gemini,groq,openai,anthropic,openrouter
# 1 = never call an LLM (templates only)
LLM_DISABLED=0

# GOOGLE_API_KEY is accepted as a fallback name
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash-lite
# requests/minute budget per provider
GEMINI_RPM=10

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_RPM=30

OPENAI_API_KEY=
# any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_RPM=60

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_RPM=50

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_RPM=20

# --- latency budgets (seconds; the judge waits 30s, the local simulator 15s) ---
LLM_TIMEOUT_S=7
# /v1/tick always answers within ~this + 1.5s
TICK_DEADLINE_S=9
# /v1/reply always answers within ~this + 1s
REPLY_DEADLINE_S=8
# compose pushed triggers in the background (LLM only)
PRECOMPOSE=1
PRECOMPOSE_CONCURRENCY=3

# --- engagement policy ---
MAX_ACTIONS_PER_TICK=20
# simulated minutes of silence after an auto-reply loop
AUTO_REPLY_COOLDOWN_MIN=60
# triggers at/above this urgency bypass cooldowns and waits
URGENT_BYPASS_URGENCY=4

# --- ops ---
# hosts usually inject this
PORT=8080
# public base URL; the bot GETs <url>/v1/healthz every SELF_PING_INTERVAL_S so free hosts don't sleep
# (defaults to RENDER_EXTERNAL_URL on Render; leave empty elsewhere)
SELF_PING_URL=
SELF_PING_INTERVAL_S=600
LOG_LEVEL=INFO
